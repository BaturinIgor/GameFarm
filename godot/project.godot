; Harvest Hollow на Godot: Android (позже и iOS).
; Спрайты, раскладки карт и строки копирует tools/godot_sync.sh (в CI то же самое).

config_version=5

[application]

config/name="Harvest Hollow"
config/description="Top-down farming adventure"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"
run/low_processor_mode=false

[autoload]

L="*res://scripts/core/l10n.gd"
Sprites="*res://scripts/core/sprites.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom_font="res://fonts/Nunito-900.ttf"
theme/default_font_antialiasing=1
common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.2, 0.6, 0.29, 1)
